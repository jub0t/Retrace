{
  "name": "retrace",
  "private": true,
  "version": "0.1.0",
  "description": "Draw step by step, play it back like a human drew it.",
  "author": "Jareer Abdullah",
  "homepage": "https://github.com/jub0t/Retrace",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jub0t/Retrace.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:mcp",
    "build:mcp": "vite build --ssr src/mcp/server.ts --outDir dist-mcp --emptyOutDir",
    "mcp": "node dist-mcp/server.js",
    "preview": "vite preview",
    "typecheck": "tsc",
    "demo": "vite build --ssr scripts/demo.ts --outDir node_modules/.cache/demo --emptyOutDir --logLevel warn && node node_modules/.cache/demo/demo.js",
    "screenshot": "sh scripts/screenshot.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "mediabunny": "^1.62.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
